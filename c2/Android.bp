cc_binary {
    name: "vendor.dolby.media.c2@1.0-service",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    init_rc: ["vendor.dolby.media.c2@1.0-service.rc"],
    srcs: ["service.cpp"],
    shared_libs: [
        "android.hardware.media.c2@1.0",
        "libbase",
        "libbinder",
        "libcodec2",
        "libcodec2_hidl@1.0",
        "libcodec2_store_dolby",
        "libhidlbase",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
